NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

DB_HOST=mysql
DB_PORT=3306
DB_USER=usuario_app
DB_PASSWORD=
# Usuario con permisos para crear otros usuarios, solo para "npm run db:usuario-app"
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
DB_NAME=tienda_online
DB_CONNECTION_LIMIT=10

JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=15m
JWT_ISSUER=microservicio-login
BCRYPT_SALT_ROUNDS=12

HTTPS_ENABLED=false
HTTPS_KEY_PATH=./certs/server.key
HTTPS_CERT_PATH=./certs/server.crt

CORS_ORIGIN=*
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

USUARIOS_DEMO_PASSWORD=ClaveDemo123

# Activar solo con SMTP y frontend para verificación de email
REQUIRE_EMAIL_VERIFICATION=false
# Activar con RECAPTCHA_SECRET real
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=
