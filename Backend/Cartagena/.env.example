# Comparte una instancia MySQL existente. NO ejecutar otro MySQL automáticamente.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tienda_online
DB_USER=usuario_app
DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_MYSQL
# MISMA clave usada por microservicio-login e historial-compras.
JWT_SECRET=REEMPLAZAR_CON_OPENSSL_RAND_HEX_32
JWT_ISSUER=microservicio-login
JWT_EXPIRES_IN=15m
REQUIRE_EMAIL_VERIFICATION=false
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# No se distribuye frontend; sólo se utiliza si configuras un origen externo propio.
CORS_ORIGIN=
GATEWAY_PORT=8081
DOTNET_PORT=8083
